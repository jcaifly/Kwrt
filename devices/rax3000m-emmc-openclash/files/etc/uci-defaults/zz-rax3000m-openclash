#!/bin/sh
# No core download, GPT/bootloader operation, subscription or preset password.
uci -q batch <<'EOF'
set openclash.config.enable='0'
set openclash.config.auto_update='0'
set openclash.config.small_flash_memory='0'
set luci.main.lang='zh_cn'
set firewall.@defaults[0].flow_offloading='0'
set firewall.@defaults[0].flow_offloading_hw='0'
# Preserve both listeners; HTTP is an explicit trusted-LAN convenience option.
set uhttpd.main.redirect_https='0'
set fstab.@global[0].anon_mount='0'
set fstab.@global[0].anon_swap='0'
set fstab.@global[0].auto_mount='0'
set fstab.@global[0].auto_swap='0'
commit openclash
commit luci
commit firewall
commit uhttpd
commit fstab
EOF

# First setup stays wired even when U-Boot happens to contain Wi-Fi presets.
for radio in $(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
    uci -q set "wireless.$radio.disabled=1"
done
uci -q commit wireless
/etc/init.d/openclash disable
# The packaged queue has no guessed bandwidth and is disabled. Keep every queue
# disabled on a fresh setup; users enable SQM only after measuring their WAN.
for queue in $(uci -q show sqm | sed -n 's/^sqm\.\([^.=]*\)=queue$/\1/p'); do
    uci -q set "sqm.$queue.enabled=0"
done
uci -q commit sqm
/etc/init.d/sqm disable
exit 0
