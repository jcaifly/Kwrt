+		;;
diff --git a/target/linux/mediatek/filogic/base-files/lib/upgrade/rax3000m-emmc.sh b/target/linux/mediatek/filogic/base-files/lib/upgrade/rax3000m-emmc.sh
new file mode 100644
index 0000000..cb18bf4
--- /dev/null
+++ b/target/linux/mediatek/filogic/base-files/lib/upgrade/rax3000m-emmc.sh
@@ -0,0 +1,55 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# Read-only capacity checks for the existing Kwrt eMMC kernel/rootfs layout.
+# Called by sysupgrade validation and again before the native stage2 writes.
+
+rax3000m_emmc_partition() {
+	local label="$1" entry found=""
+	for entry in /sys/class/block/mmcblk*p*; do
+		[ -r "$entry/uevent" ] || continue
+		grep -qx "PARTNAME=$label" "$entry/uevent" || continue
+		[ -z "$found" ] || return 1
+		found="${entry##*/}"
+	done
+	[ -n "$found" ] || return 1
+	printf '%s\n' "$found"
+}
+
+rax3000m_emmc_check_image() {
+	local image="$1" folder="sysupgrade-cmcc_rax3000m-emmc"
+	local members kern root kern_sectors root_sectors kern_bytes root_bytes root_end backup_bytes=4096
+	members="$(tar tf "$image" 2>/dev/null)" || return 1
+	[ "$members" = "$folder/
+$folder/CONTROL
+$folder/kernel
+$folder/root" ] || {
+		echo "Expected the Kwrt RAX3000M eMMC kernel/rootfs sysupgrade TAR." >&2
+		return 1
+	}
+	if ! kern="$(rax3000m_emmc_partition kernel)" || ! root="$(rax3000m_emmc_partition rootfs)"; then
+		echo "Missing or ambiguous existing eMMC kernel/rootfs partitions." >&2
+		return 1
+	fi
+	[ "${kern%%p[0-9]*}" = "${root%%p[0-9]*}" ] || return 1
+	kern_sectors="$(cat "/sys/class/block/$kern/size")" || return 1
+	root_sectors="$(cat "/sys/class/block/$root/size")" || return 1
+	case "$kern_sectors:$root_sectors" in
+		*[!0-9:]*|:*|*:) return 1 ;;
+	esac
+	[ -b "/dev/$kern" ] && [ -b "/dev/$root" ] || return 1
+	kern_bytes="$(tar xOf "$image" "$folder/kernel" | wc -c)"
+	root_bytes="$(tar xOf "$image" "$folder/root" | wc -c)"
+	[ "$kern_bytes" -gt 0 ] && [ "$root_bytes" -gt 0 ] || return 1
+	[ -z "$UPGRADE_BACKUP" ] || {
+		backup_bytes="$(wc -c < "$UPGRADE_BACKUP")" || return 1
+		[ "$backup_bytes" -ge 4096 ] || backup_bytes=4096
+	}
+	# libfstools/rootdisk and emmc_upgrade_tar align the overlay at 64 KiB.
+	root_end=$(( (root_bytes + 65535) / 65536 * 65536 ))
+	if [ "$kern_bytes" -gt "$((kern_sectors * 512))" ] ||
+		[ "$((root_end + backup_bytes))" -gt "$((root_sectors * 512))" ]; then
+		echo "Image/backup does not fit the existing eMMC partitions; layout remains unchanged." >&2
+		return 1
+	fi
+	export EMMC_KERN_DEV="/dev/$kern" EMMC_ROOT_DEV="/dev/$root"
+	unset EMMC_DATA_DEV EMMC_DTB_DEV CI_DATAPART CI_DTBPART
+}
diff --git a/target/linux/mediatek/image/filogic.mk b/target/linux/mediatek/image/filogic.mk
index 5ae0305..01e35bf 100644
--- a/target/linux/mediatek/image/filogic.mk
+++ b/target/linux/mediatek/image/filogic.mk
@@ -937,0 +938,13 @@ TARGET_DEVICES += cmcc_rax3000m
+# Kwrt's existing kernel/rootfs eMMC layout; leave the official unified profile intact.
+define Device/cmcc_rax3000m-emmc
+  DEVICE_VENDOR := CMCC
+  DEVICE_MODEL := RAX3000M eMMC
+  DEVICE_DTS := mt7981b-cmcc-rax3000m-emmc-kwrt
+  DEVICE_DTS_DIR := ../dts
+  DEVICE_PACKAGES := kmod-mt7915e kmod-mt7981-firmware mt7981-wo-firmware kmod-usb3 \
+	e2fsprogs f2fsck mkf2fs losetup kmod-fs-f2fs kmod-mmc
+  IMAGES := sysupgrade.bin
+  IMAGE/sysupgrade.bin := sysupgrade-tar | append-metadata
+endef
+TARGET_DEVICES += cmcc_rax3000m-emmc
+
